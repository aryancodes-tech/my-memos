{
  "name": "mymemos-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/clean-dev-artifacts.mjs",
    "dev": "vite",
    "dev:reset": "npm run predev && vite",
    "dev:check": "node scripts/check-dev-setup.mjs",
    "dev:watch": "vite build --watch",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc -b --noEmit && vite build --config vite.web.config.ts",
    "prebuild": "node scripts/guard-production-build.mjs",
    "build": "tsc -b --noEmit && vite build && node scripts/finish-production-build.mjs",
    "build:force": "FORCE_BUILD=1 npm run build",
    "package": "npm run build:force && cd dist && zip -r ../mymemos-extension.zip . && cp ../mymemos-extension.zip ../../public/mymemos-extension.zip",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.6.6",
    "@tiptap/extension-task-list": "^2.6.6",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "flexsearch": "^0.7.43",
    "idb": "^8.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.445.0",
    "lz-string": "^1.5.0",
    "markdown-it-mark": "^4.0.0",
    "nanoid": "^5.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tiptap-markdown": "^0.8.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
