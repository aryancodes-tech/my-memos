{
  "name": "mymemos",
  "version": "0.1.0",
  "description": "Local-first personal knowledge management Chrome extension with an optional landing site",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryancodes-tech/my-memos.git"
  },
  "bugs": {
    "url": "https://github.com/aryancodes-tech/my-memos/issues"
  },
  "homepage": "https://github.com/aryancodes-tech/my-memos#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "chrome-extension",
    "memos",
    "notion",
    "tiptap",
    "local-first",
    "new-tab",
    "chrome-extension"
  ],
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix extension",
    "predev:web": "node scripts/check-node-version.mjs",
    "dev:web": "vite dev",
    "dev:app": "npm run dev:web --prefix extension",
    "dev:extension": "npm run dev --prefix extension",
    "build:app": "npm run build:web --prefix extension",
    "prebuild:web": "node scripts/check-node-version.mjs",
    "build:web": "npm run build:app && vite build",
    "build:extension": "npm run build:force --prefix extension",
    "package:extension": "npm run package --prefix extension && cp extension/mymemos-extension.zip public/mymemos-extension.zip",
    "prepreview": "node scripts/check-node-version.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --prefix extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:extension && npm run build:web"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "happy-dom": "^17.4.7",
    "nitro": "^3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
